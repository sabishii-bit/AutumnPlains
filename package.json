{
  "name": "autumnplains-monorepo",
  "version": "1.0.0",
  "description": "Babylon.js multiplayer game - Monorepo",
  "private": true,
  "scripts": {
    "dev:client": "pnpm --filter @autumnplains/client dev",
    "dev:server": "pnpm --filter @autumnplains/server dev",
    "dev": "pnpm --parallel --filter @autumnplains/client --filter @autumnplains/server dev",
    "build:client": "pnpm --filter @autumnplains/client build",
    "build:server": "pnpm --filter @autumnplains/server build",
    "build": "pnpm --filter @autumnplains/client build && pnpm --filter @autumnplains/server build",
    "start:server": "pnpm --filter @autumnplains/server start"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
